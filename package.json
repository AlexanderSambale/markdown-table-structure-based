{
  "name": "markdown-table-structure-based",
  "displayName": "Markdown Table structure based",
  "description": "Copying tables to have them in markdown sometimes requires a lot of manual interaction. This extensions is to automate some of the cases.",
  "license": "MIT",
  "version": "0.4.1",
  "icon": "images/icons/table.png",
  "publisher": "samxela",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "Markdown",
    "Tables"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderSambale/markdown-table-structure-based"
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:mdx",
    "onLanguage:rmd",
    "onLanguage:quarto"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdown-table-structure-based.create",
        "enablement": "editorLangId =~ /^markdown$|^rmd$|^quarto$|^mdx$/",
        "title": "create table",
        "category": "Markdown"
      },
      {
        "command": "markdown-table-structure-based.concat",
        "enablement": "editorLangId =~ /^markdown$|^rmd$|^quarto$|^mdx$/",
        "title": "concatenate tables",
        "category": "Markdown"
      },
      {
        "command": "markdown-table-structure-based.concatReverse",
        "enablement": "editorLangId =~ /^markdown$|^rmd$|^quarto$|^mdx$/",
        "title": "concatenate tables in reverse order",
        "category": "Markdown"
      },
      {
        "command": "markdown-table-structure-based.transpose",
        "enablement": "editorLangId =~ /^markdown$|^rmd$|^quarto$|^mdx$/",
        "title": "transpose table",
        "category": "Markdown"
      },
      {
        "command": "markdown-table-structure-based.toLines",
        "enablement": "editorLangId =~ /^markdown$|^rmd$|^quarto$|^mdx$/",
        "title": "to lines (reverse of create)",
        "category": "Markdown"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "check-types": "tsc --noEmit",
    "compile": "yarn run check-types && node esbuild.js",
    "package": "yarn run check-types && node esbuild.js --production",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "pretest": "yarn run lint && yarn run compile-tests",
    "lint": "eslint src --ext ts",
    "compile-tests": "tsc -p . --outDir out",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.28.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "grapheme-splitter": "^1.0.4"
  }
}